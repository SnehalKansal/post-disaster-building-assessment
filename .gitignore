# Python virtual environments
.venv/
venv/
env/
ENV/

# Python caches and build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Environment files
.env
.env.*
!.env.example

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Generated data outputs
data/processed/*
!data/processed/.gitkeep
data/outputs/*
!data/outputs/.gitkeep
backend/static/uploads/*
!backend/static/uploads/.gitkeep
backend/static/heatmaps/*
!backend/static/heatmaps/.gitkeep
backend/static/overlays/*
!backend/static/overlays/.gitkeep
backend/static/geojson/*
!backend/static/geojson/.gitkeep

# Large satellite imagery
*.tif
*.tiff

# Trained model weights (tens of MB - distribute via release/Drive, not git)
ml/models/**/*.safetensors
ml/models/**/*.pth
ml/models/**/*.pt
ml/models/**/*.bin
