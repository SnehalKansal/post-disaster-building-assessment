# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+psycopg2://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@localhost:5432/YOUR_DATABASE_NAME
POSTGRES_USER=YOUR_DATABASE_USER
POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD
POSTGRES_DB=YOUR_DATABASE_NAME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional overrides
# Directory holding segformer_localization_best/ and siamese_damage_best.pth
# MODEL_DIR=../ml/models

# "cpu" or "cuda"; leave unset to auto-detect
# INFERENCE_DEVICE=

# Contours smaller than this many pixels are discarded as segmentation noise
# MIN_BUILDING_AREA=40
